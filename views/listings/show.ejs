<% layout("/layouts/boilerplate.ejs") %>


    <body>
        <div class="row mt-3">
            <div class="col-8 offset-3">
                <h3>
                    <%= listings.title %>
                </h3>
            </div>
            <div class="card col-6 offset-3">
                <img src="<%= listings.image.url %>" class="card-img-top show-img" alt="listings-img">
                <div class="card-body">
                    <p class="card-text">
                        <i>
                            owned by:<%= listings.owner.username %>
                        </i>
                        <br>
                        <%= listings.description %> <br>
                            &#8377;<%= listings.price.toLocaleString("en-IN") %> <br>
                                <%= listings.location %> <br>
                                    <%= listings.country %>
                    </p>
                </div>
            </div>
        </div>
        <div class="mt-3 row">
            <% if(curruser && listings.owner._id.equals(curruser._id)){ %>
                <div class="col-8  btns offset-5 ">
                    <a href="/listings/<%= listings._id %>/edit" class="btn btn-dark col-1  btn1 ">Edit</a>

                    <form method="post" action="/listings/<%= listings._id %>?_method=DELETE">
                        <button class="btn btn-dark  offset-11  btn1 ">Delete </button>
                    </form>
                </div>
                <% } %>
        </div>
        <hr>
        <% if(curruser){%>
            <div class="col-6 offset-3">
                <h4>Leave a Review</h4>
                <form action="/listings/<%= listings._id %>/review" method="post" novalidate
                    class=" needs-validation mb-3">

                    <div class="mt-3 mb-3">
                        <fieldset class="starability-slot">
                            <legend>First rating:</legend>
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0"
                                checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]  " value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>
                    <div class="mb3">
                        <label for="comment" class="form-label">Comments</label>
                        <textarea name="review[Comment]" id="comment" cols="30" rows="5" class="form-control"
                            required></textarea>
                        <div class="invalid-feedback">
                            Please Add some comments for review
                        </div>
                    </div>
                    <button class="btn btn-outline-dark mt-3">submit</button>
                </form>
            </div>
            <hr>
            <% }%>
                <div class="row offset-3">
                    <p><b>All Reviews</b></p>
                    <div class="row">
                        <% for (review of listings.reviews) {%>
                            <div class=" card col-4 ms-3 mb-3 soon">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        @<%= review.author.username %>
                                    </h5>
                                    <p class="card-text">
                                        <%= review.Comment %>
                                    </p>
                                    <p class="starability-result card-text" data-rating=<%=review.rating %>>
                                        Rated: stars
                                    </p>
                                </div>
                                <form class="mb-3 mt-2" method="post"
                                    action="/listings/<%= listings._id %>/review/<%= review._id %>?_method=DELETE">
                                    <button class="btn btn-dark btn-sm ">Delete</button>
                                </form>
                            </div>
                            <% } %>
                    </div>
                </div>
                <br><br>
    </body